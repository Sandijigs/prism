{
  "name": "@prism-protocol/cre-workflows",
  "version": "0.1.0",
  "description": "Chainlink CRE workflows for PRISM Protocol risk monitoring and automated protection",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "postinstall": "bun x cre-setup",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx src/simulate.ts",
    "simulate:verbose": "tsx src/simulate.ts --verbose",
    "demo": "tsx src/demo-live.ts",
    "demo:verbose": "tsx src/demo-live.ts --verbose"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "^1.0.9",
    "chalk": "^5.4.0",
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
